{
  "name": "academy-locator",
  "version": "0.1.0",
  "description": "Academy Locator — інтерактивна карта STEAM-освіти Харкова (MVP API)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test",
    "test:mongo": "node --env-file=.env --test",
    "test:web": "vitest run",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "mongodb": "^6.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.18.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "supertest": "^7.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
