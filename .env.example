PORT=3000
# Порожнє значення => MemoryStore (дані з data/seed у пам'яті)
MONGODB_URI=
MONGODB_DB=academy_locator
# Порожнє значення => адмін-роути вимкнені
ADMIN_TOKEN=
# Потрібно лише якщо фронтенд живе на іншому домені
CORS_ORIGIN=
# Ліміт запитів до /api з однієї IP за вікно (за замовчуванням 300 за 15 хв)
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
# Ліміт POST-запитів з однієї IP (за замовчуванням 30 за 15 хв)
WRITE_RATE_LIMIT_MAX=
WRITE_RATE_LIMIT_WINDOW_MS=
